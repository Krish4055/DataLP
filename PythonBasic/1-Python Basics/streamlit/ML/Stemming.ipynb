   "id": "6071187c",
   "metadata": {},
   "outputs": [],
   "source": [
    "from nltk.stem import PorterStemmer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "3238fc52",
   "metadata": {},
   "outputs": [],
   "source": [
    "stemming = PorterStemmer()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "754c1bff",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "eaten--->eaten\n",
      "eating--->eat\n",
      "eating--->eat\n"
     ]
    }
   ],
   "source": [
    "for word in words :\n",
    "    print(word+\"--->\"+stemming.stem(word))"
   ]
